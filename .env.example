# StudioFlow local infrastructure.
# Docker Compose uses these same values as defaults, so copying this file is optional.
# Copy to .env only when you want local overrides.

# Container images
POSTGRES_IMAGE=postgres:18.4-alpine3.24
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MAILPIT_IMAGE=axllent/mailpit:v1.30.1
CLAMAV_IMAGE=clamav/clamav:1.5.3-debian13-slim
ADMINER_IMAGE=adminer:5.5.0-standalone
SMOKE_TOOLS_IMAGE=busybox:1.37.0

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=studioflow
POSTGRES_MIGRATION_USER=studioflow_migrator
POSTGRES_MIGRATION_PASSWORD=studioflow_migrator_dev
POSTGRES_APP_USER=studioflow_app
POSTGRES_APP_PASSWORD=studioflow_app_dev
POSTGRES_WORKER_USER=studioflow_worker
POSTGRES_WORKER_PASSWORD=studioflow_worker_dev

# Application and release database URLs (active from M04)
DATABASE_URL=postgresql://studioflow_app:studioflow_app_dev@127.0.0.1:5432/studioflow
MIGRATION_DATABASE_URL=postgresql://studioflow_migrator:studioflow_migrator_dev@127.0.0.1:5432/studioflow
WORKER_DATABASE_URL=postgresql://studioflow_worker:studioflow_worker_dev@127.0.0.1:5432/studioflow

# MinIO / S3-compatible local storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=studioflow
MINIO_ROOT_PASSWORD=studioflow_minio_dev
MINIO_BUCKET=studioflow-local
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=studioflow-local
S3_ACCESS_KEY=studioflow
S3_SECRET_KEY=studioflow_minio_dev

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=1000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ClamAV
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Optional Adminer profile
ADMINER_PORT=8080
